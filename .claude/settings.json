{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.crt)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/secrets/**)",
      "Read(./**/credentials*)",
      "Read(./**/*.tfvars)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",

      "Read(./input/private/**)",

      "Read(./output/**)",
      "Read(./artifacts/**)",
      "Read(./**/*.pdf)",
      "Read(./**/*.docx)",
      "Read(./**/*.doc)",

      "Read(./**/bin/**)",
      "Read(./**/obj/**)",
      "Read(./**/*.exe)",
      "Read(./**/*.dll)",
      "Read(./**/*.pdb)",
      "Read(./**/*.nupkg)",

      "Read(./**/__pycache__/**)",
      "Read(./.cache/**)",

      "Read(./.git/**)",
      "Read(./.vs/**)",
      "Read(./.vscode/**)",
      "Read(./.idea/**)",
      "Read(./**/*.swp)",
      "Read(./**/*.swo)",
      "Read(./**/*~)",

      "Read(./**/*.png)",
      "Read(./**/*.jpg)",
      "Read(./**/*.jpeg)",
      "Read(./**/*.gif)",
      "Read(./**/*.ico)",
      "Read(./**/*.ttf)",
      "Read(./**/*.otf)",
      "Read(./**/*.woff)",
      "Read(./**/*.woff2)",
      "Read(./**/*.zip)",
      "Read(./**/*.tar)",
      "Read(./**/*.tar.gz)",
      "Read(./**/*.tgz)",
      "Read(./**/*.7z)",

      "Read(./**/*.log)",
      "Read(./logs/**)",
      "Read(./tmp/**)",
      "Read(./**/*.tmp)",
      "Read(./**/*.bak)",
      "Read(./**/*.orig)",
      "Read(./**/.DS_Store)",
      "Read(./**/Thumbs.db)"
    ]
  }
}
